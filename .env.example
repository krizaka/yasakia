# -------------------------------------------------------------
# Yasakia — environment template. `npm run setup` copies it to .env and generates AUTH_SESSION_SECRET and
# DATABASE_ENCRYPTION_KEY. In production every secret below is mandatory: the server refuses to start without the ones
# every request needs (apps/web/lib/env.ts assertProductionConfig), and a request that needs a missing one answers 503
# — never a placeholder, never a demo mode.
# -------------------------------------------------------------

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Secrets (generated by `npm run setup`) ────────────────────────────────────────────────────
# Signs the session tokens and, derived, the upload and local media URLs. 32+ random characters (`openssl rand -hex 32`).
AUTH_SESSION_SECRET=
# Encrypts the sensitive fields at rest (sensitive facets, report details, stored exports): AES-256-GCM.
# 32 random bytes in base64 (`openssl rand -base64 32`). Keep it: data sealed with it cannot be read without it.
DATABASE_ENCRYPTION_KEY=
# Rotation: the previous keys, comma separated — values they sealed still open; new values use DATABASE_ENCRYPTION_KEY.
# DATABASE_ENCRYPTION_KEYS_PREVIOUS=

# ── PostgreSQL 16 + pgvector (deploy/docker/docker-compose.dev.yml, port 5435) ─────────────────
DATABASE_URL=postgresql://yasakia_user:yasakia_secret@localhost:5435/yasakia_db?sslmode=disable
# A direct (session) connection for LISTEN (the realtime bus) and the migrations, when DATABASE_URL goes through a
# transaction pooler (PgBouncer). Without it, DATABASE_URL is used for both — and must then be direct.
# DATABASE_DIRECT_URL=
# CA of a managed PostgreSQL (PEM), verified with TLS; on DigitalOcean App Platform: ${<db>.CA_CERT}
# DATABASE_CA_CERT=
# Connections this process may hold in its one pool (default 5, at most 50). Budget, docs/DEPLOYMENT.md:
# (instances + 1 during a rolling deploy) × (this + 1 LISTEN) + migrate job + admin ≤ 70 % of the database's slots.
DATABASE_MAX_CONNECTIONS=5
# Development deployments only: lets the release job rebuild a database whose migration history was squashed.
# DATABASE_ALLOW_RESET=

# ── Photos (packages/media) ─────────────────────────────────────────────────────────────────────
# `local` (development: files in .storage/, served by the signed /api/media route) or `bunny` (production: required).
MEDIA_STORAGE_PROVIDER=local
# MEDIA_STORAGE_LOCAL_DIR=
# Bunny Storage zone `yasakia` and its pull zone (Optimizer on, token authentication on — the key below).
MEDIA_STORAGE_ZONE=
MEDIA_STORAGE_API_KEY=
# The zone's region host: storage.bunnycdn.com (Falkenstein), ny.storage.bunnycdn.com, la.…, sg.…, syd.…
MEDIA_STORAGE_ENDPOINT=storage.bunnycdn.com
MEDIA_CDN_HOSTNAME=
MEDIA_CDN_TOKEN_AUTH_KEY=
# Photo moderation: `auto` (V1 — approved at once; a report reopens the review).
MEDIA_PHOTO_MODERATION=auto

# ── E-mail (sign-in codes, deletion confirmation) ───────────────────────────────────────────────
# MAIL_PROVIDER picks the service (mailgun). Production always delivers and is fail-closed without it (a sign-in code is
# never logged there).
# Elsewhere: MAIL_DELIVERY=on sends through Mailgun, `file` writes each message to MAIL_OUTBOX_DIR (default
# .mail-outbox/ — the e2e scenarios read the codes there), anything else logs it.
MAIL_DELIVERY=log
# MAIL_OUTBOX_DIR=
MAIL_PROVIDER=mailgun
MAIL_API_KEY=
# The sending domain of Yasakia (e.g. mg.yasakia.com) — to be created in Mailgun.
MAIL_DOMAIN=
# MAIL_API_URL=https://api.eu.mailgun.net
MAIL_FROM=Yasakia <no-reply@mg.yasakia.com>

# ── Realtime (GET /api/events) and push ─────────────────────────────────────────────────────────
# postgres (default — LISTEN/NOTIFY, no broker) · redis (Redis / Valkey at REALTIME_REDIS_URL, several instances) · memory (tests)
REALTIME_BUS=postgres
# REALTIME_REDIS_URL=redis://localhost:6379
# REALTIME_PREFIX=yasakia:rt:
# REALTIME_STREAM_MAX_SECONDS=300
# Pushes leave only in production, or here with PUSH_DELIVERY=on. PUSH_ACCESS_TOKEN: with "enhanced push security".
# PUSH_DELIVERY=
# PUSH_ACCESS_TOKEN=

# ── Abuse and operators ─────────────────────────────────────────────────────────────────────────
# memory (one instance) · postgres (shared — required before a second instance)
ABUSE_RATE_LIMIT_STORE=memory
# The header the edge sets with the client's address (DigitalOcean App Platform: do-connecting-ip).
# ABUSE_CLIENT_IP_HEADER=
# ABUSE_TRUSTED_PROXY_HOPS=1
# The operators' service token for /api/admin/* (32+ characters) and the addresses allowed to call it (comma
# separated; empty: any outside production, none in production).
OPERATOR_API_TOKEN=
OPERATOR_ALLOWED_IPS=

# ── Background loops (apps/web/lib/jobs.ts) and exports ─────────────────────────────────────────
# APP_ACCOUNT_PURGE_INTERVAL_SECONDS=60
# APP_SWEEP_INTERVAL_SECONDS=600
# APP_EXPORT_SYNC_BUDGET_MS=1000
