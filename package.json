{
  "name": "yasakia-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Yasakia \u2014 the dating app where you talk first: the API, the packages (db, media), the docs and the legal pages.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build:site && node scripts/sync-site.mjs && npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "lint": "npm run lint --workspaces --if-present && npm run check:i18n && npm run ratchet && ast-grep test --skip-snapshot-tests && node scripts/sg-ratchet.mjs",
    "check:i18n": "krizaka-i18n check apps/web/messages && krizaka-i18n check apps/web/messages/errors && krizaka-i18n scan apps/web/app apps/web/components --allow Yasakia,YASAKIA,Krizaka,KRIZAKA,Bunny --skip /app/api/ && krizaka-i18n check apps/site/messages && krizaka-i18n scan apps/site/app apps/site/components --allow Yasakia,YASAKIA,Krizaka,KRIZAKA,Bunny",
    "ratchet": "krizaka-ratchet",
    "ratchet:update": "krizaka-ratchet --update",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/site/tsconfig.json",
    "test": "vitest run",
    "check:overflow": "node scripts/check-overflow.mjs",
    "test:e2e": "node e2e/run.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run docs:generate -- --check",
    "db:up": "docker compose -f deploy/docker/docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f deploy/docker/docker-compose.dev.yml down",
    "db:generate": "npm run generate --workspace=packages/db --",
    "db:migrate": "npm run migrate --workspace=packages/db",
    "db:seed": "npm run seed --workspace=packages/db",
    "db:qa-accounts": "npm run qa-accounts --workspace=packages/db",
    "db:check": "npm run check --workspace=packages/db",
    "db:studio": "npm run studio --workspace=packages/db",
    "db:status": "node scripts/db.mjs status",
    "db:reset": "node scripts/db.mjs reset",
    "db:psql": "node scripts/db.mjs psql",
    "db:dump": "node scripts/db.mjs dump",
    "db:restore": "node scripts/db.mjs restore",
    "docs:generate": "node scripts/generate-docs.mjs",
    "workspace": "node scripts/workspace.mjs",
    "mail:templates:preview": "tsx apps/web/scripts/mail-templates.ts",
    "build:site": "npm run build -w apps/site",
    "dev:site": "npm run dev -w apps/site",
    "lint:sg": "node scripts/sg-ratchet.mjs",
    "lint:sg:test": "ast-grep test --skip-snapshot-tests",
    "sg:ratchet:update": "node scripts/sg-ratchet.mjs --update",
    "sg:fix": "node scripts/sg-fix.mjs",
    "db:qa-reset": "npm run qa-reset --workspace=packages/db",
    "dev:journey": "node scripts/dev-journey.mjs",
    "db:qa-personas": "tsx apps/web/scripts/qa-personas.ts"
  },
  "keywords": [
    "dating-app",
    "ai-agent",
    "matching",
    "pgvector",
    "nextjs",
    "drizzle-orm",
    "open-source"
  ],
  "author": "Krizaka Core Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "@krizaka/config": "^0.7.0",
    "@ast-grep/cli": "0.51.0",
    "@krizaka/i18n": "^0.2.2",
    "pg": "^8.12.0",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
